# ==================================================================
# ClimateShield Nexus — Environment Variable Template
# Copy to .env and fill in real values. NEVER commit a real .env file.
# Full reference & descriptions: docs/31_Environment_Variables.md
# ==================================================================

# ---------- General ----------
NODE_ENV=development
APP_NAME=climateshield-nexus
APP_ENV=local
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=debug
TZ=Africa/Nairobi
DEFAULT_LOCALE=en-KE

# ---------- API Gateway ----------
GATEWAY_PORT=4000
GATEWAY_RATE_LIMIT_PER_MIN=120

# ---------- Authentication / Authorization ----------
AUTH_PROVIDER=oidc
OIDC_ISSUER_URL=https://auth.climateshield-nexus.local/realms/climateshield
OIDC_CLIENT_ID=climateshield-web
OIDC_CLIENT_SECRET=change-me
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
JWT_SIGNING_ALGORITHM=RS256
MFA_ENABLED=true
SESSION_SECRET=change-me-32-char-minimum-secret

# ---------- Primary Database (PostgreSQL + PostGIS) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=climateshield_nexus
DB_USER=climateshield_app
DB_PASSWORD=change-me
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# ---------- Time-Series Store (TimescaleDB) ----------
TSDB_HOST=localhost
TSDB_PORT=5433
TSDB_NAME=climateshield_timeseries
TSDB_USER=climateshield_ts
TSDB_PASSWORD=change-me

# ---------- Cache / Queue ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=climateshield-nexus

# ---------- Object Storage (S3-compatible) ----------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET_RAW=climate-raw-data
OBJECT_STORAGE_BUCKET_PROCESSED=climate-processed-data
OBJECT_STORAGE_BUCKET_REPORTS=climate-reports
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me

# ---------- GIS Services ----------
GEOSERVER_URL=http://localhost:8080/geoserver
MAPBOX_ACCESS_TOKEN=change-me
GDAL_CACHEMAX=512

# ---------- External Climate Data Sources ----------
NWP_GFS_ENDPOINT=https://nomads.ncep.noaa.gov
NWP_ECMWF_API_KEY=change-me
SATELLITE_PROVIDER_API_KEY=change-me
KMD_STATION_NETWORK_API_URL=https://stations.kmd.example/api
KMD_STATION_NETWORK_API_KEY=change-me

# ---------- AI / ML ----------
AI_MODEL_PROVIDER=anthropic
AI_MODEL_API_KEY=change-me
AI_MODEL_NAME=claude-sonnet-5
ML_TRAINING_ARTIFACT_STORE=s3://climateshield-ml-artifacts
MLFLOW_TRACKING_URI=http://localhost:5001

# ---------- Alerts / Notifications ----------
SMS_PROVIDER=africastalking
SMS_API_KEY=change-me
SMS_SENDER_ID=CLIMSHIELD
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=change-me
EMAIL_SMTP_PASSWORD=change-me
PUSH_NOTIFICATION_PROVIDER=fcm
FCM_SERVER_KEY=change-me
CAP_ALERT_FEED_URL=https://alerts.climateshield-nexus.local/cap/v1

# ---------- Observability ----------
PROMETHEUS_METRICS_PORT=9100
GRAFANA_URL=http://localhost:3001
SENTRY_DSN=
OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------- Feature Flags ----------
FEATURE_AI_ASSISTANT=true
FEATURE_MOBILE_APP=false
FEATURE_MULTI_TENANT=false
