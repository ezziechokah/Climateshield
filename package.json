{
  "name": "climateshield-nexus",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Climate Risk Intelligence Platform for Africa — monorepo root. See README.md and docs/38_Project_Structure.md.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "frontend",
    "backend/*",
    "mobile",
    "packages/*",
    "sdk/typescript"
  ],
  "scripts": {
    "//lint": "Lint every workspace package. Wired into .github/workflows/lint.yml",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "bash scripts/run-dev.sh",
    "clean": "bash scripts/clean.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.30.0",
    "husky": "^9.1.5",
    "lint-staged": "^17.2.0",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yml,yaml}": ["prettier --write"],
    "*.py": ["ruff check --fix", "ruff format"]
  }
}
