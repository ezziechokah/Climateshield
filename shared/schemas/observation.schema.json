{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://climateshield-nexus.example/schemas/observation.schema.json",
  "title": "Observation",
  "description": "Mirrors docs/09_Database_Dictionary.md#observation. Validation contract only.",
  "type": "object",
  "required": ["id", "data_source_id", "parameter", "value", "unit", "observed_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "station_id": { "type": ["string", "null"], "format": "uuid" },
    "data_source_id": { "type": "string", "format": "uuid" },
    "parameter": {
      "type": "string",
      "examples": ["temperature", "rainfall", "humidity", "wind_speed"]
    },
    "value": { "type": "number" },
    "unit": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "is_corrected": { "type": "boolean", "default": false },
    "superseded_by": { "type": ["string", "null"], "format": "uuid" }
  },
  "additionalProperties": false
}
